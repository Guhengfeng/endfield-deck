    {/* 顶部信息 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, height: 34, marginLeft: 60, marginTop: 60, position: 'relative', zIndex: 2 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center', width: 62, height: 30, background: '#FFFA00' }}>
